{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI — dev (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.main:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "env": {
        "APP_APP__DEBUG": "true",
        "APP_APP__LOG_LEVEL": "DEBUG"
      },
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "FastAPI — sans reload (breakpoints fiables)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.main:app",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "jinja": true,
      "justMyCode": false,
      "env": {
        "APP_APP__DEBUG": "true",
        "APP_APP__LOG_LEVEL": "DEBUG"
      },
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Pytest — tous les tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v"
      ],
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Pytest — fichier courant",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v"
      ],
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ]
}
